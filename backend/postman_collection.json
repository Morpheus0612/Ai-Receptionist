{
  "info": {
    "name": "Voice AI Receptionist API",
    "description": "Postman API collection for testing AI Receptionist call flow, calendar, TabPFN, Tinker, and hardware endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["health"]
        }
      }
    },
    {
      "name": "Scene 1: Start Call",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"caller_name\": \"Jordan Vance\",\n  \"caller_number\": \"+1-415-555-0182\",\n  \"company\": \"Nexus Robotics\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/calls/start",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "calls", "start"]
        }
      }
    },
    {
      "name": "Scene 2: Send Meeting Utterance (Missing Details)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"call_sid\": \"{{call_sid}}\",\n  \"utterance\": \"Can you arrange a meeting with the sales team next Tuesday?\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/calls/utterance",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "calls", "utterance"]
        }
      }
    },
    {
      "name": "Scene 3: Send Confirmation Details (Book Meeting)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"call_sid\": \"{{call_sid}}\",\n  \"utterance\": \"Sure, 2:00 PM works best for me. My name is Jordan Vance and email is jordan.vance@nexusrobotics.io.\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/calls/utterance",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "calls", "utterance"]
        }
      }
    },
    {
      "name": "Scene 4 & 5: End Call (TabPFN Priority Trigger)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"call_sid\": \"{{call_sid}}\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/calls/end",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "calls", "end"]
        }
      }
    },
    {
      "name": "TabPFN: Direct Priority Prediction",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"intent\": \"support_query\",\n  \"urgency\": 0.95,\n  \"sentiment\": \"negative\",\n  \"is_repeat_caller\": true,\n  \"requires_follow_up\": true,\n  \"estimated_deal_size\": 35000.0,\n  \"duration_seconds\": 120,\n  \"missing_details\": [\"diagnostic_dump\"]\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/tabpfn/predict",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "tabpfn", "predict"]
        }
      }
    },
    {
      "name": "Tinker: Benchmark Evaluation",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8000/api/tinker/benchmark",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "tinker", "benchmark"]
        }
      }
    },
    {
      "name": "Hardware: Push Button Action",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"action\": \"ACKNOWLEDGE\"\n}"
        },
        "url": {
          "raw": "http://localhost:8000/api/hardware/button",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8000",
          "path": ["api", "hardware", "button"]
        }
      }
    }
  ]
}
